# Three files hold secrets, none of them committed:
#   .dev.vars                          local: `wrangler dev` loads it. Copy this file to create it.
#   .dev.vars.staging / .production    deployed environments, sent to Cloudflare with
#                                      `npm run secrets:push -- --env staging`. Template:
#                                      .dev.vars.deployed.example. Do not put real credentials in .dev.vars.
# Beware: `wrangler dev --env staging` would load .dev.vars.staging, i.e. real staging credentials.
# After adding a secret here, run `npm run cf-typegen` so it shows up on c.env.

# ZeptoMail "Send Mail token" (ZeptoMail → Mail Agent → Setup Info → API).
ZEPTOMAIL_API_KEY=
# WhatsApp Cloud API access token (Meta → WhatsApp → API setup; use a permanent system-user token).
# Only needed once whatsapp is in OTP_CHANNELS.
WHATSAPP_ACCESS_TOKEN=
# Secret mixed into stored OTP hashes. Generate one with: openssl rand -hex 32
OTP_PEPPER=
# Signs access and refresh tokens. Generate with: openssl rand -hex 32. Use a different value per environment.
JWT_SECRET=
# Only while rotating JWT_SECRET: put the old value here so existing tokens keep verifying. Leave blank otherwise.
JWT_SECRET_PREVIOUS=
# Keys the hash of device ids. Generate with: openssl rand -hex 32. NEVER rotate it: that orphans every device's guest.
DEVICE_ID_KEY=
# Anthropic API key for product research and analysis (Claude Console → API keys). Required.
# Use a separate key or workspace per environment, so spend limits and revocation are per environment.
ANTHROPIC_API_KEY=
# Expo robot-user access token for push notifications (Expo → account → Access tokens). Required.
# Also turn on "Enhanced security for push notifications" in the Expo project settings.
# Use a separate token per environment if you like; sharing one is fine.
EXPO_ACCESS_TOKEN=
# Perfect Corp (YouCam) API key for the face scan (Perfect Corp console → API keys). Required: a deploy fails until it is set.
PERFECT_CORP_API_KEY=
# Perfect Corp webhook secret ("whsec_..."), shown when the webhook URL is registered in their console. Required: a deploy fails until it is set.
PERFECT_CORP_WEBHOOK_SECRET=
