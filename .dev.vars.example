# Copy to .dev.vars for local secrets (never committed). wrangler dev loads it automatically.
# In production, set each one with: npx wrangler secret put NAME
# After adding a secret here, run `npm run cf-typegen` so it shows up on c.env.

# WhatsApp Cloud API access token (Meta → WhatsApp → API setup; use a permanent system-user token).
WHATSAPP_ACCESS_TOKEN=
# Secret mixed into stored OTP hashes. Generate one with: openssl rand -hex 32
OTP_PEPPER=
