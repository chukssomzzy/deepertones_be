{
  "name": "deepertones-be",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --minify --env staging",
    "deploy:production": "wrangler deploy --minify --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars=false",
    "typecheck": "tsc",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "openapi": "tsx scripts/openapi.ts",
    "prompts": "tsx scripts/prompts.ts",
    "emails:preview": "tsx scripts/email-preview.ts",
    "assets:sync": "tsx scripts/sync-assets.ts",
    "catalog:contract-doc": "tsx scripts/catalog-contract-doc.ts",
    "eval:catalog": "tsx scripts/eval-catalog.ts",
    "eval:shelf": "tsx scripts/eval/shelf.ts",
    "eval:matching": "tsx scripts/eval/matching.ts",
    "ai:spend": "tsx scripts/ai-spend.ts",
    "secrets:push": "tsx scripts/push-secrets.ts",
    "openapi:lint": "REDOCLY_TELEMETRY=off redocly lint docs/openapi.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:scripts": "vitest run --project scripts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "html-to-text": "^9.0.5",
    "libphonenumber-js": "^1.13.15",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@redocly/cli": "^2.62.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.5.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.110.0",
    "yaml": "^2.9.1"
  }
}
