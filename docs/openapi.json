    "/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "tags": [
          "Auth"
        ],
        "summary": "Trade a refresh token for a new token pair",
        "description": "Ignores the Authorization header, so an expired access token does not matter.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The same user, new tokens",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ],
                      "description": "Always true for a 2xx response."
                    },
                    "status": {
                      "type": "integer",
                      "description": "The HTTP status code, repeated for clients that only keep the body."
                    },
                    "message": {
                      "type": "string",
                      "description": "Human-readable; may change."
                    },
                    "data": {
                      "$ref": "#/components/schemas/Session"
                    }
                  },
                  "required": [
                    "success",
                    "status",
                    "message",
                    "data"
