        },
        "responses": {
          "200": {
            "description": "The code is on its way",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ],
                      "description": "Always true for a 2xx response."
                    },
                    "status": {
                      "type": "integer",
                      "description": "The HTTP status code, repeated for clients that only keep the body."
