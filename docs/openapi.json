        "operationId": "logout",
        "tags": [
          "Auth"
        ],
        "summary": "Sign out everywhere and start a fresh guest session",
        "description": "Every refresh token the user holds stops working. The response is a new guest for this device.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
