                    "message": {
                      "type": "string",
                      "description": "Human-readable; may change."
                    },
                    "data": {
                      "$ref": "#/components/schemas/OtpChallengeResponse"
                    }
                  },
                  "required": [
                    "success",
                    "status",
                    "message",
                    "data"
                  ]
                }
              }
            }
