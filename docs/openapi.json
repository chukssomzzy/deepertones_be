{
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "https://api.deepertones.com",
      "description": "Production"
    },
    {
      "url": "https://api.staging.deepertones.com",
      "description": "Staging"
    }
  ],
  "info": {
    "title": "deepertones API",
    "version": "1.0.0",
    "description": "Every error response has the same body: `{ error: { code, message, details?, requestId } }`. Branch on `code`, not on `message`."
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "description": "`degraded` when any check is down."
          },
          "environment": {
            "type": "string",
            "example": "staging"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "ok",
                  "down"
                ]
              }
            },
            "required": [
              "database"
            ]
          }
        },
        "required": [
          "status",
          "environment",
          "checks"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable, machine-readable code.",
                "example": "NOT_FOUND"
              },
              "message": {
                "type": "string",
                "description": "Human-readable; may change. Branch on `code`."
              },
              "details": {
                "description": "Extra context. For VALIDATION_FAILED: a list of `{ path, message }`, one per invalid field."
              },
              "requestId": {
                "type": "string",
                "description": "Also sent as the X-Request-Id header. Quote it when reporting a bug."
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "Health"
        ],
        "summary": "Check the API and its dependencies",
        "description": "For uptime checks: the status code alone says whether the API can serve requests.",
        "responses": {
          "200": {
            "description": "Everything is reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Running, but a dependency (e.g. the database) is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
