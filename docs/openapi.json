              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "The body is not JSON (Content-Type must be application/json)",
            "content": {
              "application/json": {
                "schema": {
