{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deepertones-be",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  // enable_request_signal makes request.signal fire in a Durable Object when the client of a streamed response goes away: without it
  // the ScanStream never learns a client left. Env blocks inherit this list; one that sets its own would replace it. Do NOT add
  // pipe_to_backward_propagation by hand: it crashed workerd at startup, and it becomes the default on 2026-11-17 anyway.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],

  // Non-secret config. Secrets go in .dev.vars locally, and in .dev.vars.<env> pushed with `npm run secrets:push` when deployed.
  // After changing vars or bindings, run `npm run cf-typegen` so c.env stays typed.
  "vars": {
    "ENVIRONMENT": "development",
    // Comma-separated list of origins allowed to call the API from a browser.
    "CORS_ORIGINS": "http://localhost:3000,http://localhost:5173",
    // "true" serves Swagger UI at /docs and the spec at /openapi.json; anything else 404s both.
    "DOCS_ENABLED": "true",
    // Comma-separated channels people can sign in with. Add whatsapp once Meta approves the authentication template.
    "OTP_CHANNELS": "email",
    // Transactional email sender. The mail. subdomain keeps app-mail reputation apart from the main domain.
    "EMAIL_FROM_ADDRESS": "no-reply@mail.deepertones.com",
    "EMAIL_FROM_NAME": "Deeper Tones",
    // The host depends on the ZeptoMail data centre: copy the exact URL from Mail Agent → Setup Info → API.
    "ZEPTOMAIL_API_URL": "https://api.zeptomail.com/v1.1/email",
    // The WhatsApp phone number id, from Meta → WhatsApp → API setup.
    "WHATSAPP_PHONE_NUMBER_ID": "1297385913467660",
    // The approved authentication template. Its code expiry must be set to 10 minutes to match OTP_POLICY.
    "WHATSAPP_OTP_TEMPLATE": "deepertones_otp",
    "WHATSAPP_OTP_LANGUAGE": "en",
    // The Claude model per job: a cheap model for the internal steps (research, reading images, judging two listings), a better one for the analysis text users read.
    "ANTHROPIC_MODEL_RESEARCH": "claude-haiku-5-5",
    "ANTHROPIC_MODEL_VISION": "claude-haiku-5-5",
    "ANTHROPIC_MODEL_RECOGNIZE_SHELF": "claude-haiku-5-5",
    "ANTHROPIC_MODEL_JUDGE": "claude-haiku-5-5",
    "ANTHROPIC_MODEL_ANALYSIS": "claude-sonnet-5-5",
    // The routine writer: its words reach users, so it is the better model, not the cheap one.
    "ANTHROPIC_MODEL_ROUTINE": "claude-sonnet-5-5",
    // Daily AI spend figure in USD, per UTC day. Alert-only: every request is still reserved and settled in the ledger, and the first call past it emails OPS_ALERT_EMAIL (once a day); no call is ever refused. There is no Console backstop, by the owner's decision.
    "AI_DAILY_BUDGET_USD": "1",
    // Where ops alerts go (Claude refusing our account, a daily limit passed). Empty = alerts are logged and dropped. Not a secret.
    "OPS_ALERT_EMAIL": "",
    // Who may approve a step-down template (the Tapers tab) in production: labels as written in the workbook's approved_by cell, separated by commas. In production only, an upload with an approved template by anyone else is refused; empty refuses every approved template. Not a secret.
    "QUALIFIED_APPROVERS": "",
    // Where deepertones-assets is served from. Empty locally: dev serves no public images, so product views show no image.
    "CATALOG_IMAGES_PUBLIC_URL": "",
    // Perfect Corp (YouCam) API address for the face scan. Its key and webhook secret are secrets (PERFECT_CORP_API_KEY, PERFECT_CORP_WEBHOOK_SECRET), not set here.
    "PERFECT_CORP_BASE_URL": "https://yce-api-01.makeupar.com",
    // USD per Perfect Corp unit, used to cost every face-scan call in the ledger: the pay-as-you-go price ($0.055, units valid a year; checked 2026-10-23 on yce.perfectcorp.com/ai-api/api-pricing). On a monthly subscription use its price instead (0.048 up to 2,000 units/mo, 0.047 at 5,000, 0.046 at 10,000).
    "PERFECT_CORP_USD_PER_UNIT": "0.055"
  },
  // Deploys fail until ZEPTOMAIL_API_KEY, OTP_PEPPER, JWT_SECRET, DEVICE_ID_KEY, ANTHROPIC_API_KEY, EXPO_ACCESS_TOKEN, PERFECT_CORP_API_KEY, PERFECT_CORP_WEBHOOK_SECRET and ADMIN_API_TOKEN are set on this environment's Worker: fill in
  // .dev.vars.<env>, then `npm run secrets:push -- --env <env> --apply`.
  // JWT_SECRET_PREVIOUS is optional: set only while rotating JWT_SECRET.
  // EXPO_ACCESS_TOKEN is an Expo robot-user access token: the push sender authenticates every send with it (enhanced push security is on).
  // WHATSAPP_ACCESS_TOKEN is not required: WhatsApp stays off until it is added to OTP_CHANNELS.
  "secrets": { "required": ["ZEPTOMAIL_API_KEY", "OTP_PEPPER", "JWT_SECRET", "DEVICE_ID_KEY", "ANTHROPIC_API_KEY", "EXPO_ACCESS_TOKEN", "PERFECT_CORP_API_KEY", "PERFECT_CORP_WEBHOOK_SECRET", "ADMIN_API_TOKEN"] },

  // Every queue below (each job's main + dead-letter pair) must exist before the first deploy that binds them;
  // README → Before the first deploy lists the full set:
  //   npx wrangler queues create deepertones-otp-delivery-development
  //   npx wrangler queues create deepertones-otp-delivery-dlq-development
  //   npx wrangler queues create deepertones-scan-items-development
  //   npx wrangler queues create deepertones-scan-items-dlq-development
  //   npx wrangler queues create deepertones-push-delivery-development
  //   npx wrangler queues create deepertones-push-delivery-dlq-development
  //   npx wrangler queues create deepertones-push-receipts-development
  //   npx wrangler queues create deepertones-push-receipts-dlq-development
  //   npx wrangler queues create deepertones-parse-safety-development
  //   npx wrangler queues create deepertones-parse-safety-dlq-development
  //   npx wrangler queues create deepertones-email-development
  //   npx wrangler queues create deepertones-email-dlq-development
  //   npx wrangler queues create deepertones-face-scans-development
  //   npx wrangler queues create deepertones-face-scans-dlq-development
  // Names must match queueNames(queue, ENVIRONMENT) in src/jobs/job.ts.
  "queues": {
    "producers": [
      { "binding": "OTP_DELIVERY_QUEUE", "queue": "deepertones-otp-delivery-development" },
      { "binding": "SCAN_ITEMS_QUEUE", "queue": "deepertones-scan-items-development" },
      { "binding": "PUSH_DELIVERY_QUEUE", "queue": "deepertones-push-delivery-development" },
      { "binding": "PUSH_RECEIPTS_QUEUE", "queue": "deepertones-push-receipts-development" },
      { "binding": "PARSE_SAFETY_QUEUE", "queue": "deepertones-parse-safety-development" },
      { "binding": "EMAIL_QUEUE", "queue": "deepertones-email-development" },
      { "binding": "FACE_SCANS_QUEUE", "queue": "deepertones-face-scans-development" }
    ],
    "consumers": [
      {
        "queue": "deepertones-otp-delivery-development",
        "max_batch_size": 10,
        // A person is waiting for the code: do not hold a partial batch.
        "max_batch_timeout": 1,
        // 5 attempts in total; then the message moves to the dead-letter queue.
        "max_retries": 4,
        "dead_letter_queue": "deepertones-otp-delivery-dlq-development"
      },
      { "queue": "deepertones-otp-delivery-dlq-development", "max_batch_size": 10 },
      {
        "queue": "deepertones-scan-items-development",
        "max_batch_size": 10,
        // A person is watching the scan: do not hold a partial batch.
        "max_batch_timeout": 1,
        // 5 attempts in total; then the message moves to the dead-letter queue, whose hook marks the item failed.
        "max_retries": 4,
        "dead_letter_queue": "deepertones-scan-items-dlq-development"
      },
      { "queue": "deepertones-scan-items-dlq-development", "max_batch_size": 10 },
      {
        "queue": "deepertones-push-delivery-development",
        "max_batch_size": 10,
        // A person is waiting for the notification: do not hold a partial batch.
        "max_batch_timeout": 1,
        // 5 attempts in total; then the message moves to the dead-letter queue.
        "max_retries": 4,
        "dead_letter_queue": "deepertones-push-delivery-dlq-development"
      },
      { "queue": "deepertones-push-delivery-dlq-development", "max_batch_size": 10 },
      {
        "queue": "deepertones-push-receipts-development",
        // Nobody waits for a receipt check: let a batch fill, or wait up to 30 seconds.
        "max_batch_size": 25,
        "max_batch_timeout": 30,
        // 5 attempts in total; then the message moves to the dead-letter queue.
        "max_retries": 4,
        "dead_letter_queue": "deepertones-push-receipts-dlq-development"
      },
      { "queue": "deepertones-push-receipts-dlq-development", "max_batch_size": 10 },
      {
        "queue": "deepertones-parse-safety-development",
        // One message at a time: a parse is a model read and a catalog research, and a batch is retried or acked as a whole.
        "max_batch_size": 1,
        // 5 attempts in total; then the message moves to the dead-letter queue, whose hook marks the parse failed.
        "max_retries": 4,
        "dead_letter_queue": "deepertones-parse-safety-dlq-development"
      },
      { "queue": "deepertones-parse-safety-dlq-development", "max_batch_size": 10 },
      {
        "queue": "deepertones-email-development",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        // 5 attempts in total; then the message moves to the dead-letter queue.
        "max_retries": 4,
        "dead_letter_queue": "deepertones-email-dlq-development"
      },
      { "queue": "deepertones-email-dlq-development", "max_batch_size": 10 },
      {
        "queue": "deepertones-face-scans-development",
        // One message at a time: a message is one exchange with Perfect Corp (an upload, task creation or a fetch), and a batch is retried or acked as a whole.
        "max_batch_size": 1,
        // 5 attempts in total; then the message moves to the dead-letter queue, whose hook marks the scan failed.
        "max_retries": 4,
        "dead_letter_queue": "deepertones-face-scans-dlq-development"
      },
      { "queue": "deepertones-face-scans-dlq-development", "max_batch_size": 10 }
    ]
  },

  // Rate limits, 60 s windows. A namespace_id is an account-wide counter: two Workers (or environments) that
  // share one id share its counts, so every binding in every environment has its own id.
  "ratelimits": [
    { "name": "AUTH_OTP_SEND_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "AUTH_OTP_SEND_USER_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    { "name": "AUTH_OTP_VERIFY_IP_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_BOOTSTRAP_IP_LIMITER", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_REFRESH_IP_LIMITER", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } },
    { "name": "SCAN_CREATE_IP_LIMITER", "namespace_id": "1006", "simple": { "limit": 20, "period": 60 } },
    { "name": "SCAN_CREATE_USER_LIMITER", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } },
    { "name": "SCAN_BACK_PHOTO_USER_LIMITER", "namespace_id": "1008", "simple": { "limit": 10, "period": 60 } },
    { "name": "SCAN_BACK_PHOTO_IP_LIMITER", "namespace_id": "1009", "simple": { "limit": 20, "period": 60 } },
    { "name": "SCAN_RETAKE_IP_LIMITER", "namespace_id": "1010", "simple": { "limit": 20, "period": 60 } },
    { "name": "SCAN_RETAKE_USER_LIMITER", "namespace_id": "1011", "simple": { "limit": 10, "period": 60 } },
    { "name": "SCAN_IDENTIFY_IP_LIMITER", "namespace_id": "1012", "simple": { "limit": 20, "period": 60 } },
    { "name": "SCAN_IDENTIFY_USER_LIMITER", "namespace_id": "1013", "simple": { "limit": 10, "period": 60 } },
    { "name": "SCAN_NO_LABEL_IP_LIMITER", "namespace_id": "1016", "simple": { "limit": 20, "period": 60 } },
    { "name": "SCAN_NO_LABEL_USER_LIMITER", "namespace_id": "1017", "simple": { "limit": 10, "period": 60 } },
    { "name": "SCAN_SHELF_IP_LIMITER", "namespace_id": "1018", "simple": { "limit": 20, "period": 60 } },
    { "name": "SCAN_SHELF_USER_LIMITER", "namespace_id": "1019", "simple": { "limit": 10, "period": 60 } },
    { "name": "GOAL_SET_IP_LIMITER", "namespace_id": "1020", "simple": { "limit": 20, "period": 60 } },
    { "name": "GOAL_SET_USER_LIMITER", "namespace_id": "1021", "simple": { "limit": 10, "period": 60 } },
    { "name": "SAFETY_SET_IP_LIMITER", "namespace_id": "1022", "simple": { "limit": 20, "period": 60 } },
    { "name": "SAFETY_SET_USER_LIMITER", "namespace_id": "1023", "simple": { "limit": 10, "period": 60 } },
    // Adding a searched product to the shelf: may start a typed scan that costs a model call, so as tight as the goal's.
    { "name": "SHELF_ADD_IP_LIMITER", "namespace_id": "1024", "simple": { "limit": 20, "period": 60 } },
    { "name": "SHELF_ADD_USER_LIMITER", "namespace_id": "1025", "simple": { "limit": 10, "period": 60 } },
    // Starting a face scan sends a photo to Perfect Corp, which is paid per use: as tight as the other routes that can cost money.
    { "name": "FACE_SCAN_IP_LIMITER", "namespace_id": "1026", "simple": { "limit": 20, "period": 60 } },
    { "name": "FACE_SCAN_USER_LIMITER", "namespace_id": "1027", "simple": { "limit": 10, "period": 60 } },
    // Perfect Corp's webhook is public and signed: the limit only stops a flood of unsigned requests from each costing a signature check.
    { "name": "PERFECT_CORP_WEBHOOK_LIMITER", "namespace_id": "1028", "simple": { "limit": 300, "period": 60 } },
    // The admin catalog routes (export and import): per address and before the token is checked, so a guess at the token costs an attempt.
    { "name": "ADMIN_IP_LIMITER", "namespace_id": "1029", "simple": { "limit": 10, "period": 60 } },
    // Saving the shopping country and budget band: cheap, but a write per call, so as tight as the goal's.
    { "name": "SHOPPING_SET_IP_LIMITER", "namespace_id": "1030", "simple": { "limit": 20, "period": 60 } },
    { "name": "SHOPPING_SET_USER_LIMITER", "namespace_id": "1031", "simple": { "limit": 10, "period": 60 } },
    { "name": "PRODUCT_SEARCH_IP_LIMITER", "namespace_id": "1014", "simple": { "limit": 120, "period": 60 } },
    { "name": "PRODUCT_SEARCH_USER_LIMITER", "namespace_id": "1015", "simple": { "limit": 60, "period": 60 } }
  ],

  // Two crons; the Worker's scheduled handler picks the job by the cron that fired (src/jobs/scheduled.ts), so a change here
  // is a change there too. Env blocks do not inherit triggers, so each deployed environment restates both.
  //   17 3 * * *      daily guest cleanup (UsersService.purgeUnreachableGuests), 03:17 UTC: off the hour to dodge the top-of-hour rush.
  //   */10 * * * *    scan reaper (ScanService.reap): queues scan steps that were lost again and fails items stuck for over 2 hours.
  "triggers": { "crons": ["17 3 * * *", "*/10 * * * *"] },

  "observability": {
    "enabled": true
  },

  // One ScanStream Durable Object per scan, reached by the scan's id (src/realtime/scan-stream.ts). Env blocks do not inherit
  // `durable_objects`, so each restates it. `migrations` is inherited, so it is declared once, here. new_sqlite_classes is the
  // SQLite-backed kind and the choice is permanent per class (the object keeps its streams in memory and stores nothing).
  // Never edit a shipped migration: a later change to the class is a new entry with a new tag.
  "durable_objects": { "bindings": [{ "name": "SCAN_STREAM", "class_name": "ScanStream" }] },
  "migrations": [{ "tag": "v1-scan-stream", "new_sqlite_classes": ["ScanStream"] }],

  // Local D1 (wrangler dev + tests). The id only names the local SQLite file; nothing remote.
  // migrations_dir must match `out` in drizzle.config.ts: drizzle-kit writes there, wrangler applies from there.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deepertones-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // The one public bucket, deepertones-assets, for everything public. The CI sync owns email/ and the other keys from the
  // repo's assets/ folder; the Worker owns catalog/<environment>/…. The two never overlap (the sync refuses a catalog/ file).
  // Here it is a local simulation: wrangler dev and the tests write to a local bucket, never the real one.
  //
  // The one private bucket, deepertones-private, for users' product photos, shared by every environment (the owner's rule).
  // Keys are prefixed photos/<environment>/…, faces/<environment>/… and workbooks/<environment>/… (the catalog workbook archive, which is kept for good,
  // so set no bucket-wide lifecycle rule). It has no public domain and r2.dev is off: photos leave only through signed
  // photo links the Worker checks. Local here too, like the public bucket.
  "r2_buckets": [
    { "binding": "CATALOG_IMAGES", "bucket_name": "deepertones-assets" },
    { "binding": "PRIVATE_PHOTOS", "bucket_name": "deepertones-private" }
  ],

  // More storage bindings, added as we need them:
  // "kv_namespaces": [{ "binding": "KV", "id": "" }],
  //
  // The test suite boots this file's top level. Never mark a binding here "remote": true:
  // tests would then talk to a real resource. Give tests their own config if one ever must be.

  // The top level above is local development: it is what `wrangler dev` and the tests read.
  // Deployed Workers only ever come from these blocks, via `--env staging` / `--env production`,
  // so a deploy can never ship the localhost config. vars and bindings are NOT inherited by an
  // env block: every one must be restated in each environment.
  "env": {
    "staging": {
      // The API's one public address. A Custom Domain: on deploy, Cloudflare creates the DNS
      // record and a certificate for it in the deepertones.com zone.
      "routes": [{ "pattern": "api.staging.deepertones.com", "custom_domain": true }],
      // No *.workers.dev or preview URLs: traffic that skips the domain also skips any zone
      // rules (WAF, rate limiting) added to deepertones.com.
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "staging",
        // TODO: the staging frontend origin(s). Empty = no browser origin allowed.
        "CORS_ORIGINS": "",
        // The frontend team reads the docs here.
        "DOCS_ENABLED": "true",
        // Comma-separated channels people can sign in with. Add whatsapp once Meta approves the authentication template.
        "OTP_CHANNELS": "email",
        // Transactional email sender. The mail. subdomain keeps app-mail reputation apart from the main domain.
        "EMAIL_FROM_ADDRESS": "no-reply@mail.deepertones.com",
        "EMAIL_FROM_NAME": "Deeper Tones",
        // The host depends on the ZeptoMail data centre: copy the exact URL from Mail Agent → Setup Info → API.
        "ZEPTOMAIL_API_URL": "https://api.zeptomail.com/v1.1/email",
        // TODO: the WhatsApp phone number id, from Meta → WhatsApp → API setup.
        "WHATSAPP_PHONE_NUMBER_ID": "",
        // The approved authentication template. Its code expiry must be set to 10 minutes to match OTP_POLICY.
        "WHATSAPP_OTP_TEMPLATE": "deepertones_otp",
        "WHATSAPP_OTP_LANGUAGE": "en",
        // The Claude model per job: a cheap model for the internal steps (research, reading images, judging two listings), a better one for the analysis text users read.
        "ANTHROPIC_MODEL_RESEARCH": "claude-haiku-5-5",
        "ANTHROPIC_MODEL_VISION": "claude-haiku-5-5",
        "ANTHROPIC_MODEL_RECOGNIZE_SHELF": "claude-haiku-5-5",
        "ANTHROPIC_MODEL_JUDGE": "claude-haiku-5-5",
        "ANTHROPIC_MODEL_ANALYSIS": "claude-sonnet-5-5",
        // The routine writer: its words reach users, so it is the better model, not the cheap one.
        "ANTHROPIC_MODEL_ROUTINE": "claude-sonnet-5-5",
        // Daily AI spend figure in USD, per UTC day. Alert-only: every request is still reserved and settled in the ledger, and the first call past it emails OPS_ALERT_EMAIL (once a day); no call is ever refused. There is no Console backstop, by the owner's decision.
        "AI_DAILY_BUDGET_USD": "5",
        // Where ops alerts go (Claude refusing our account, a daily limit passed). Empty = alerts are logged and dropped. Not a secret.
        "OPS_ALERT_EMAIL": "",
        // Who may approve a step-down template (the Tapers tab) in production: labels as written in the workbook's approved_by cell, separated by commas. In production only, an upload with an approved template by anyone else is refused; empty refuses every approved template. Not a secret.
        "QUALIFIED_APPROVERS": "",
        // Where deepertones-assets is served from (its custom domain).
        "CATALOG_IMAGES_PUBLIC_URL": "https://assets.deepertones.com",
        // Perfect Corp (YouCam) API address for the face scan. Its key and webhook secret are secrets (PERFECT_CORP_API_KEY, PERFECT_CORP_WEBHOOK_SECRET), not set here.
        "PERFECT_CORP_BASE_URL": "https://yce-api-01.makeupar.com",
        // USD per Perfect Corp unit, used to cost every face-scan call in the ledger: the pay-as-you-go price ($0.055, units valid a year; checked 2026-10-23 on yce.perfectcorp.com/ai-api/api-pricing). On a monthly subscription use its price instead (0.048 up to 2,000 units/mo, 0.047 at 5,000, 0.046 at 10,000).
        "PERFECT_CORP_USD_PER_UNIT": "0.055"
      },
      // Deploys fail until ZEPTOMAIL_API_KEY, OTP_PEPPER, JWT_SECRET, DEVICE_ID_KEY, ANTHROPIC_API_KEY, EXPO_ACCESS_TOKEN, PERFECT_CORP_API_KEY, PERFECT_CORP_WEBHOOK_SECRET and ADMIN_API_TOKEN are set on this environment's Worker: fill in
      // .dev.vars.<env>, then `npm run secrets:push -- --env <env> --apply`.
      // JWT_SECRET_PREVIOUS is optional: set only while rotating JWT_SECRET.
      // EXPO_ACCESS_TOKEN is an Expo robot-user access token: the push sender authenticates every send with it (enhanced push security is on).
      // WHATSAPP_ACCESS_TOKEN is not required: WhatsApp stays off until it is added to OTP_CHANNELS.
      "secrets": { "required": ["ZEPTOMAIL_API_KEY", "OTP_PEPPER", "JWT_SECRET", "DEVICE_ID_KEY", "ANTHROPIC_API_KEY", "EXPO_ACCESS_TOKEN", "PERFECT_CORP_API_KEY", "PERFECT_CORP_WEBHOOK_SECRET", "ADMIN_API_TOKEN"] },
      // Every queue below (each job's main + dead-letter pair) must exist before the first deploy that binds them;
      // README → Before the first deploy lists the full set:
      //   npx wrangler queues create deepertones-otp-delivery-staging
      //   npx wrangler queues create deepertones-otp-delivery-dlq-staging
      //   npx wrangler queues create deepertones-scan-items-staging
      //   npx wrangler queues create deepertones-scan-items-dlq-staging
      //   npx wrangler queues create deepertones-push-delivery-staging
      //   npx wrangler queues create deepertones-push-delivery-dlq-staging
      //   npx wrangler queues create deepertones-push-receipts-staging
      //   npx wrangler queues create deepertones-push-receipts-dlq-staging
      //   npx wrangler queues create deepertones-parse-safety-staging
      //   npx wrangler queues create deepertones-parse-safety-dlq-staging
      //   npx wrangler queues create deepertones-email-staging
      //   npx wrangler queues create deepertones-email-dlq-staging
      //   npx wrangler queues create deepertones-face-scans-staging
      //   npx wrangler queues create deepertones-face-scans-dlq-staging
      // Names must match queueNames(queue, ENVIRONMENT) in src/jobs/job.ts.
      "queues": {
        "producers": [
          { "binding": "OTP_DELIVERY_QUEUE", "queue": "deepertones-otp-delivery-staging" },
          { "binding": "SCAN_ITEMS_QUEUE", "queue": "deepertones-scan-items-staging" },
          { "binding": "PUSH_DELIVERY_QUEUE", "queue": "deepertones-push-delivery-staging" },
          { "binding": "PUSH_RECEIPTS_QUEUE", "queue": "deepertones-push-receipts-staging" },
          { "binding": "PARSE_SAFETY_QUEUE", "queue": "deepertones-parse-safety-staging" },
          { "binding": "EMAIL_QUEUE", "queue": "deepertones-email-staging" },
          { "binding": "FACE_SCANS_QUEUE", "queue": "deepertones-face-scans-staging" }
        ],
        "consumers": [
          {
            "queue": "deepertones-otp-delivery-staging",
            "max_batch_size": 10,
            // A person is waiting for the code: do not hold a partial batch.
            "max_batch_timeout": 1,
            // 5 attempts in total; then the message moves to the dead-letter queue.
            "max_retries": 4,
            "dead_letter_queue": "deepertones-otp-delivery-dlq-staging"
          },
          { "queue": "deepertones-otp-delivery-dlq-staging", "max_batch_size": 10 },
          {
            "queue": "deepertones-scan-items-staging",
            "max_batch_size": 10,
            // A person is watching the scan: do not hold a partial batch.
            "max_batch_timeout": 1,
            // 5 attempts in total; then the message moves to the dead-letter queue, whose hook marks the item failed.
            "max_retries": 4,
            "dead_letter_queue": "deepertones-scan-items-dlq-staging"
          },
          { "queue": "deepertones-scan-items-dlq-staging", "max_batch_size": 10 },
          {
            "queue": "deepertones-push-delivery-staging",
            "max_batch_size": 10,
            // A person is waiting for the notification: do not hold a partial batch.
            "max_batch_timeout": 1,
            // 5 attempts in total; then the message moves to the dead-letter queue.
            "max_retries": 4,
            "dead_letter_queue": "deepertones-push-delivery-dlq-staging"
          },
          { "queue": "deepertones-push-delivery-dlq-staging", "max_batch_size": 10 },
          {
            "queue": "deepertones-push-receipts-staging",
            // Nobody waits for a receipt check: let a batch fill, or wait up to 30 seconds.
            "max_batch_size": 25,
            "max_batch_timeout": 30,
            // 5 attempts in total; then the message moves to the dead-letter queue.
            "max_retries": 4,
            "dead_letter_queue": "deepertones-push-receipts-dlq-staging"
          },
          { "queue": "deepertones-push-receipts-dlq-staging", "max_batch_size": 10 },
          {
            "queue": "deepertones-parse-safety-staging",
            // One message at a time: a parse is a model read and a catalog research, and a batch is retried or acked as a whole.
            "max_batch_size": 1,
            // 5 attempts in total; then the message moves to the dead-letter queue, whose hook marks the parse failed.
            "max_retries": 4,
            "dead_letter_queue": "deepertones-parse-safety-dlq-staging"
          },
          { "queue": "deepertones-parse-safety-dlq-staging", "max_batch_size": 10 },
          {
            "queue": "deepertones-email-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            // 5 attempts in total; then the message moves to the dead-letter queue.
            "max_retries": 4,
            "dead_letter_queue": "deepertones-email-dlq-staging"
          },
          { "queue": "deepertones-email-dlq-staging", "max_batch_size": 10 },
          {
            "queue": "deepertones-face-scans-staging",
            // One message at a time: a message is one exchange with Perfect Corp (an upload, task creation or a fetch), and a batch is retried or acked as a whole.
            "max_batch_size": 1,
            // 5 attempts in total; then the message moves to the dead-letter queue, whose hook marks the scan failed.
            "max_retries": 4,
            "dead_letter_queue": "deepertones-face-scans-dlq-staging"
          },
          { "queue": "deepertones-face-scans-dlq-staging", "max_batch_size": 10 }
        ]
      },
      // Rate limits, 60 s windows. A namespace_id is an account-wide counter: two Workers (or environments) that
      // share one id share its counts, so every binding in every environment has its own id.
      "ratelimits": [
        { "name": "AUTH_OTP_SEND_IP_LIMITER", "namespace_id": "2001", "simple": { "limit": 3, "period": 60 } },
        { "name": "AUTH_OTP_SEND_USER_LIMITER", "namespace_id": "2002", "simple": { "limit": 3, "period": 60 } },
        { "name": "AUTH_OTP_VERIFY_IP_LIMITER", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
        { "name": "AUTH_BOOTSTRAP_IP_LIMITER", "namespace_id": "2004", "simple": { "limit": 10, "period": 60 } },
        { "name": "AUTH_REFRESH_IP_LIMITER", "namespace_id": "2005", "simple": { "limit": 30, "period": 60 } },
        { "name": "SCAN_CREATE_IP_LIMITER", "namespace_id": "2006", "simple": { "limit": 20, "period": 60 } },
        { "name": "SCAN_CREATE_USER_LIMITER", "namespace_id": "2007", "simple": { "limit": 10, "period": 60 } },
        { "name": "SCAN_BACK_PHOTO_USER_LIMITER", "namespace_id": "2008", "simple": { "limit": 10, "period": 60 } },
        { "name": "SCAN_BACK_PHOTO_IP_LIMITER", "namespace_id": "2009", "simple": { "limit": 20, "period": 60 } },
        { "name": "SCAN_RETAKE_IP_LIMITER", "namespace_id": "2010", "simple": { "limit": 20, "period": 60 } },
        { "name": "SCAN_RETAKE_USER_LIMITER", "namespace_id": "2011", "simple": { "limit": 10, "period": 60 } },
        { "name": "SCAN_IDENTIFY_IP_LIMITER", "namespace_id": "2012", "simple": { "limit": 20, "period": 60 } },
        { "name": "SCAN_IDENTIFY_USER_LIMITER", "namespace_id": "2013", "simple": { "limit": 10, "period": 60 } },
        { "name": "SCAN_NO_LABEL_IP_LIMITER", "namespace_id": "2016", "simple": { "limit": 20, "period": 60 } },
        { "name": "SCAN_NO_LABEL_USER_LIMITER", "namespace_id": "2017", "simple": { "limit": 10, "period": 60 } },
        { "name": "SCAN_SHELF_IP_LIMITER", "namespace_id": "2018", "simple": { "limit": 20, "period": 60 } },
        { "name": "SCAN_SHELF_USER_LIMITER", "namespace_id": "2019", "simple": { "limit": 10, "period": 60 } },
        { "name": "GOAL_SET_IP_LIMITER", "namespace_id": "2020", "simple": { "limit": 20, "period": 60 } },
        { "name": "GOAL_SET_USER_LIMITER", "namespace_id": "2021", "simple": { "limit": 10, "period": 60 } },
        { "name": "SAFETY_SET_IP_LIMITER", "namespace_id": "2022", "simple": { "limit": 20, "period": 60 } },
        { "name": "SAFETY_SET_USER_LIMITER", "namespace_id": "2023", "simple": { "limit": 10, "period": 60 } },
        // Adding a searched product to the shelf: may start a typed scan that costs a model call, so as tight as the goal's.
        { "name": "SHELF_ADD_IP_LIMITER", "namespace_id": "2024", "simple": { "limit": 20, "period": 60 } },
        { "name": "SHELF_ADD_USER_LIMITER", "namespace_id": "2025", "simple": { "limit": 10, "period": 60 } },
        // Starting a face scan sends a photo to Perfect Corp, which is paid per use: as tight as the other routes that can cost money.
        { "name": "FACE_SCAN_IP_LIMITER", "namespace_id": "2026", "simple": { "limit": 20, "period": 60 } },
        { "name": "FACE_SCAN_USER_LIMITER", "namespace_id": "2027", "simple": { "limit": 10, "period": 60 } },
        // Perfect Corp's webhook is public and signed: the limit only stops a flood of unsigned requests from each costing a signature check.
        { "name": "PERFECT_CORP_WEBHOOK_LIMITER", "namespace_id": "2028", "simple": { "limit": 300, "period": 60 } },
        // The admin catalog routes (export and import): per address and before the token is checked, so a guess at the token costs an attempt.
        { "name": "ADMIN_IP_LIMITER", "namespace_id": "2029", "simple": { "limit": 10, "period": 60 } },
        // Saving the shopping country and budget band: cheap, but a write per call, so as tight as the goal's.
        { "name": "SHOPPING_SET_IP_LIMITER", "namespace_id": "2030", "simple": { "limit": 20, "period": 60 } },
        { "name": "SHOPPING_SET_USER_LIMITER", "namespace_id": "2031", "simple": { "limit": 10, "period": 60 } },
        { "name": "PRODUCT_SEARCH_IP_LIMITER", "namespace_id": "2014", "simple": { "limit": 120, "period": 60 } },
        { "name": "PRODUCT_SEARCH_USER_LIMITER", "namespace_id": "2015", "simple": { "limit": 60, "period": 60 } }
      ],
      // Daily guest cleanup at 03:17 UTC and the scan reaper every 10 minutes (see the top level).
      "triggers": { "crons": ["17 3 * * *", "*/10 * * * *"] },
      // One ScanStream Durable Object per scan, reached by the scan's id (src/realtime/scan-stream.ts). Env blocks do not inherit this.
      "durable_objects": { "bindings": [{ "name": "SCAN_STREAM", "class_name": "ScanStream" }] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "deepertones-staging",
          "database_id": "558afc3f-0a25-488f-9e7c-d62675124507",
          "migrations_dir": "migrations"
        }
      ],
      // The one public bucket, shared with the CI sync, which owns email/ and the other repo assets/ keys. The Worker writes
      // only under catalog/<environment>/…, so the two never overlap.
      //
      // The one private bucket for every environment (the owner's rule): keys are prefixed photos/<environment>/…, it has no
      // public domain and r2.dev is off, so photos leave only through signed photo links.
      "r2_buckets": [
        { "binding": "CATALOG_IMAGES", "bucket_name": "deepertones-assets" },
        { "binding": "PRIVATE_PHOTOS", "bucket_name": "deepertones-private" }
      ]
    },
    "production": {
      "routes": [{ "pattern": "api.deepertones.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        // TODO: the production frontend origin(s). Empty = no browser origin allowed.
        "CORS_ORIGINS": "",
        // Production does not advertise its API surface. Flip to "true" to publish the docs.
        "DOCS_ENABLED": "false",
        // Comma-separated channels people can sign in with. Add whatsapp once Meta approves the authentication template.
        "OTP_CHANNELS": "email",
        // Transactional email sender. The mail. subdomain keeps app-mail reputation apart from the main domain.
        "EMAIL_FROM_ADDRESS": "no-reply@mail.deepertones.com",
        "EMAIL_FROM_NAME": "Deeper Tones",
        // The host depends on the ZeptoMail data centre: copy the exact URL from Mail Agent → Setup Info → API.
        "ZEPTOMAIL_API_URL": "https://api.zeptomail.com/v1.1/email",
        // TODO: the WhatsApp phone number id, from Meta → WhatsApp → API setup.
        "WHATSAPP_PHONE_NUMBER_ID": "",
        // The approved authentication template. Its code expiry must be set to 10 minutes to match OTP_POLICY.
        "WHATSAPP_OTP_TEMPLATE": "deepertones_otp",
        "WHATSAPP_OTP_LANGUAGE": "en",
        // The Claude model per job: a cheap model for the internal steps (research, reading images, judging two listings), a better one for the analysis text users read.
        "ANTHROPIC_MODEL_RESEARCH": "claude-haiku-5-5",
        "ANTHROPIC_MODEL_VISION": "claude-haiku-5-5",
        "ANTHROPIC_MODEL_RECOGNIZE_SHELF": "claude-haiku-5-5",
        "ANTHROPIC_MODEL_JUDGE": "claude-haiku-5-5",
        "ANTHROPIC_MODEL_ANALYSIS": "claude-sonnet-5-5",
        // The routine writer: its words reach users, so it is the better model, not the cheap one.
        "ANTHROPIC_MODEL_ROUTINE": "claude-sonnet-5-5",
        // Daily AI spend figure in USD, per UTC day. Alert-only: every request is still reserved and settled in the ledger, and the first call past it emails OPS_ALERT_EMAIL (once a day); no call is ever refused. There is no Console backstop, by the owner's decision.
        "AI_DAILY_BUDGET_USD": "30",
        // Where ops alerts go (Claude refusing our account, a daily limit passed). Empty = alerts are logged and dropped. Not a secret.
        "OPS_ALERT_EMAIL": "",
        // Who may approve a step-down template (the Tapers tab) in production: labels as written in the workbook's approved_by cell, separated by commas. In production only, an upload with an approved template by anyone else is refused; empty refuses every approved template. Not a secret.
        "QUALIFIED_APPROVERS": "",
        // Where deepertones-assets is served from (its custom domain).
        "CATALOG_IMAGES_PUBLIC_URL": "https://assets.deepertones.com",
        // Perfect Corp (YouCam) API address for the face scan. Its key and webhook secret are secrets (PERFECT_CORP_API_KEY, PERFECT_CORP_WEBHOOK_SECRET), not set here.
        "PERFECT_CORP_BASE_URL": "https://yce-api-01.makeupar.com",
        // USD per Perfect Corp unit, used to cost every face-scan call in the ledger: the pay-as-you-go price ($0.055, units valid a year; checked 2026-10-23 on yce.perfectcorp.com/ai-api/api-pricing). On a monthly subscription use its price instead (0.048 up to 2,000 units/mo, 0.047 at 5,000, 0.046 at 10,000).
        "PERFECT_CORP_USD_PER_UNIT": "0.055"
      },
      // Deploys fail until ZEPTOMAIL_API_KEY, OTP_PEPPER, JWT_SECRET, DEVICE_ID_KEY, ANTHROPIC_API_KEY, EXPO_ACCESS_TOKEN, PERFECT_CORP_API_KEY, PERFECT_CORP_WEBHOOK_SECRET and ADMIN_API_TOKEN are set on this environment's Worker: fill in
      // .dev.vars.<env>, then `npm run secrets:push -- --env <env> --apply`.
      // JWT_SECRET_PREVIOUS is optional: set only while rotating JWT_SECRET.
      // EXPO_ACCESS_TOKEN is an Expo robot-user access token: the push sender authenticates every send with it (enhanced push security is on).
      // WHATSAPP_ACCESS_TOKEN is not required: WhatsApp stays off until it is added to OTP_CHANNELS.
      "secrets": { "required": ["ZEPTOMAIL_API_KEY", "OTP_PEPPER", "JWT_SECRET", "DEVICE_ID_KEY", "ANTHROPIC_API_KEY", "EXPO_ACCESS_TOKEN", "PERFECT_CORP_API_KEY", "PERFECT_CORP_WEBHOOK_SECRET", "ADMIN_API_TOKEN"] },
      // Every queue below (each job's main + dead-letter pair) must exist before the first deploy that binds them;
      // README → Before the first deploy lists the full set:
      //   npx wrangler queues create deepertones-otp-delivery-production
      //   npx wrangler queues create deepertones-otp-delivery-dlq-production
      //   npx wrangler queues create deepertones-scan-items-production
      //   npx wrangler queues create deepertones-scan-items-dlq-production
      //   npx wrangler queues create deepertones-push-delivery-production
      //   npx wrangler queues create deepertones-push-delivery-dlq-production
      //   npx wrangler queues create deepertones-push-receipts-production
      //   npx wrangler queues create deepertones-push-receipts-dlq-production
      //   npx wrangler queues create deepertones-parse-safety-production
      //   npx wrangler queues create deepertones-parse-safety-dlq-production
      //   npx wrangler queues create deepertones-email-production
      //   npx wrangler queues create deepertones-email-dlq-production
      //   npx wrangler queues create deepertones-face-scans-production
      //   npx wrangler queues create deepertones-face-scans-dlq-production
      // Names must match queueNames(queue, ENVIRONMENT) in src/jobs/job.ts.
      "queues": {
        "producers": [
          { "binding": "OTP_DELIVERY_QUEUE", "queue": "deepertones-otp-delivery-production" },
          { "binding": "SCAN_ITEMS_QUEUE", "queue": "deepertones-scan-items-production" },
          { "binding": "PUSH_DELIVERY_QUEUE", "queue": "deepertones-push-delivery-production" },
          { "binding": "PUSH_RECEIPTS_QUEUE", "queue": "deepertones-push-receipts-production" },
          { "binding": "PARSE_SAFETY_QUEUE", "queue": "deepertones-parse-safety-production" },
          { "binding": "EMAIL_QUEUE", "queue": "deepertones-email-production" },
          { "binding": "FACE_SCANS_QUEUE", "queue": "deepertones-face-scans-production" }
        ],
        "consumers": [
          {
            "queue": "deepertones-otp-delivery-production",
            "max_batch_size": 10,
            // A person is waiting for the code: do not hold a partial batch.
            "max_batch_timeout": 1,
            // 5 attempts in total; then the message moves to the dead-letter queue.
            "max_retries": 4,
            "dead_letter_queue": "deepertones-otp-delivery-dlq-production"
          },
          { "queue": "deepertones-otp-delivery-dlq-production", "max_batch_size": 10 },
          {
            "queue": "deepertones-scan-items-production",
            "max_batch_size": 10,
            // A person is watching the scan: do not hold a partial batch.
            "max_batch_timeout": 1,
            // 5 attempts in total; then the message moves to the dead-letter queue, whose hook marks the item failed.
            "max_retries": 4,
            "dead_letter_queue": "deepertones-scan-items-dlq-production"
          },
          { "queue": "deepertones-scan-items-dlq-production", "max_batch_size": 10 },
          {
            "queue": "deepertones-push-delivery-production",
            "max_batch_size": 10,
            // A person is waiting for the notification: do not hold a partial batch.
            "max_batch_timeout": 1,
            // 5 attempts in total; then the message moves to the dead-letter queue.
            "max_retries": 4,
            "dead_letter_queue": "deepertones-push-delivery-dlq-production"
          },
          { "queue": "deepertones-push-delivery-dlq-production", "max_batch_size": 10 },
          {
            "queue": "deepertones-push-receipts-production",
            // Nobody waits for a receipt check: let a batch fill, or wait up to 30 seconds.
            "max_batch_size": 25,
            "max_batch_timeout": 30,
            // 5 attempts in total; then the message moves to the dead-letter queue.
            "max_retries": 4,
            "dead_letter_queue": "deepertones-push-receipts-dlq-production"
          },
          { "queue": "deepertones-push-receipts-dlq-production", "max_batch_size": 10 },
          {
            "queue": "deepertones-parse-safety-production",
            // One message at a time: a parse is a model read and a catalog research, and a batch is retried or acked as a whole.
            "max_batch_size": 1,
            // 5 attempts in total; then the message moves to the dead-letter queue, whose hook marks the parse failed.
            "max_retries": 4,
            "dead_letter_queue": "deepertones-parse-safety-dlq-production"
          },
          { "queue": "deepertones-parse-safety-dlq-production", "max_batch_size": 10 },
          {
            "queue": "deepertones-email-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            // 5 attempts in total; then the message moves to the dead-letter queue.
            "max_retries": 4,
            "dead_letter_queue": "deepertones-email-dlq-production"
          },
          { "queue": "deepertones-email-dlq-production", "max_batch_size": 10 },
          {
            "queue": "deepertones-face-scans-production",
            // One message at a time: a message is one exchange with Perfect Corp (an upload, task creation or a fetch), and a batch is retried or acked as a whole.
            "max_batch_size": 1,
            // 5 attempts in total; then the message moves to the dead-letter queue, whose hook marks the scan failed.
            "max_retries": 4,
            "dead_letter_queue": "deepertones-face-scans-dlq-production"
          },
          { "queue": "deepertones-face-scans-dlq-production", "max_batch_size": 10 }
        ]
      },
      // Rate limits, 60 s windows. A namespace_id is an account-wide counter: two Workers (or environments) that
      // share one id share its counts, so every binding in every environment has its own id.
      "ratelimits": [
        { "name": "AUTH_OTP_SEND_IP_LIMITER", "namespace_id": "3001", "simple": { "limit": 3, "period": 60 } },
        { "name": "AUTH_OTP_SEND_USER_LIMITER", "namespace_id": "3002", "simple": { "limit": 3, "period": 60 } },
        { "name": "AUTH_OTP_VERIFY_IP_LIMITER", "namespace_id": "3003", "simple": { "limit": 10, "period": 60 } },
        { "name": "AUTH_BOOTSTRAP_IP_LIMITER", "namespace_id": "3004", "simple": { "limit": 10, "period": 60 } },
        { "name": "AUTH_REFRESH_IP_LIMITER", "namespace_id": "3005", "simple": { "limit": 30, "period": 60 } },
        { "name": "SCAN_CREATE_IP_LIMITER", "namespace_id": "3006", "simple": { "limit": 20, "period": 60 } },
        { "name": "SCAN_CREATE_USER_LIMITER", "namespace_id": "3007", "simple": { "limit": 10, "period": 60 } },
        { "name": "SCAN_BACK_PHOTO_USER_LIMITER", "namespace_id": "3008", "simple": { "limit": 10, "period": 60 } },
        { "name": "SCAN_BACK_PHOTO_IP_LIMITER", "namespace_id": "3009", "simple": { "limit": 20, "period": 60 } },
        { "name": "SCAN_RETAKE_IP_LIMITER", "namespace_id": "3010", "simple": { "limit": 20, "period": 60 } },
        { "name": "SCAN_RETAKE_USER_LIMITER", "namespace_id": "3011", "simple": { "limit": 10, "period": 60 } },
        { "name": "SCAN_IDENTIFY_IP_LIMITER", "namespace_id": "3012", "simple": { "limit": 20, "period": 60 } },
        { "name": "SCAN_IDENTIFY_USER_LIMITER", "namespace_id": "3013", "simple": { "limit": 10, "period": 60 } },
        { "name": "SCAN_NO_LABEL_IP_LIMITER", "namespace_id": "3016", "simple": { "limit": 20, "period": 60 } },
        { "name": "SCAN_NO_LABEL_USER_LIMITER", "namespace_id": "3017", "simple": { "limit": 10, "period": 60 } },
        { "name": "SCAN_SHELF_IP_LIMITER", "namespace_id": "3018", "simple": { "limit": 20, "period": 60 } },
        { "name": "SCAN_SHELF_USER_LIMITER", "namespace_id": "3019", "simple": { "limit": 10, "period": 60 } },
        { "name": "GOAL_SET_IP_LIMITER", "namespace_id": "3020", "simple": { "limit": 20, "period": 60 } },
        { "name": "GOAL_SET_USER_LIMITER", "namespace_id": "3021", "simple": { "limit": 10, "period": 60 } },
        { "name": "SAFETY_SET_IP_LIMITER", "namespace_id": "3022", "simple": { "limit": 20, "period": 60 } },
        { "name": "SAFETY_SET_USER_LIMITER", "namespace_id": "3023", "simple": { "limit": 10, "period": 60 } },
        // Adding a searched product to the shelf: may start a typed scan that costs a model call, so as tight as the goal's.
        { "name": "SHELF_ADD_IP_LIMITER", "namespace_id": "3024", "simple": { "limit": 20, "period": 60 } },
        { "name": "SHELF_ADD_USER_LIMITER", "namespace_id": "3025", "simple": { "limit": 10, "period": 60 } },
        // Starting a face scan sends a photo to Perfect Corp, which is paid per use: as tight as the other routes that can cost money.
        { "name": "FACE_SCAN_IP_LIMITER", "namespace_id": "3026", "simple": { "limit": 20, "period": 60 } },
        { "name": "FACE_SCAN_USER_LIMITER", "namespace_id": "3027", "simple": { "limit": 10, "period": 60 } },
        // Perfect Corp's webhook is public and signed: the limit only stops a flood of unsigned requests from each costing a signature check.
        { "name": "PERFECT_CORP_WEBHOOK_LIMITER", "namespace_id": "3028", "simple": { "limit": 300, "period": 60 } },
        // The admin catalog routes (export and import): per address and before the token is checked, so a guess at the token costs an attempt.
        { "name": "ADMIN_IP_LIMITER", "namespace_id": "3029", "simple": { "limit": 10, "period": 60 } },
        // Saving the shopping country and budget band: cheap, but a write per call, so as tight as the goal's.
        { "name": "SHOPPING_SET_IP_LIMITER", "namespace_id": "3030", "simple": { "limit": 20, "period": 60 } },
        { "name": "SHOPPING_SET_USER_LIMITER", "namespace_id": "3031", "simple": { "limit": 10, "period": 60 } },
        { "name": "PRODUCT_SEARCH_IP_LIMITER", "namespace_id": "3014", "simple": { "limit": 120, "period": 60 } },
        { "name": "PRODUCT_SEARCH_USER_LIMITER", "namespace_id": "3015", "simple": { "limit": 60, "period": 60 } }
      ],
      // Daily guest cleanup at 03:17 UTC and the scan reaper every 10 minutes (see the top level).
      "triggers": { "crons": ["17 3 * * *", "*/10 * * * *"] },
      // One ScanStream Durable Object per scan, reached by the scan's id (src/realtime/scan-stream.ts). Env blocks do not inherit this.
      "durable_objects": { "bindings": [{ "name": "SCAN_STREAM", "class_name": "ScanStream" }] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "deepertones-production",
          "database_id": "2a224d3f-1ddb-4761-a21b-5025502b2fce",
          "migrations_dir": "migrations"
        }
      ],
      // The one public bucket, shared with the CI sync, which owns email/ and the other repo assets/ keys. The Worker writes
      // only under catalog/<environment>/…, so the two never overlap.
      //
      // The one private bucket for every environment (the owner's rule): keys are prefixed photos/<environment>/…, it has no
      // public domain and r2.dev is off, so photos leave only through signed photo links.
      "r2_buckets": [
        { "binding": "CATALOG_IMAGES", "bucket_name": "deepertones-assets" },
        { "binding": "PRIVATE_PHOTOS", "bucket_name": "deepertones-private" }
      ]
    }
  }
}
